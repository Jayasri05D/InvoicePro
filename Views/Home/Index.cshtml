
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <div class="p-4 p-md-5 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #172554, #2563eb);">
        <h1 class="display-6 fw-bold">Welcome to InvoicePro</h1>
        <p class="lead mb-4">
            Manage your products today and build a smarter invoicing workflow.
        </p>
        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-light btn-lg">
            <i class="bi bi-box-seam"></i> Manage Products
        </a>

        <a asp-controller="Products"
           asp-action="Create"
           class="btn btn-outline-light btn-lg ms-2">
            Add Product
        </a>
    </div>

    <h2 class="h4 mb-3">Quick Access</h2>

    <div class="row g-4">

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                    <h5 class="card-title">Products</h5>
                    <p class="text-secondary">
                        Add products, update prices and manage availability.
                    </p>
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Products
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3 text-success">
                        <i class="bi bi-people fs-1"></i>
                    </div>
                    <h5 class="card-title">Customers</h5>
                    <p class="text-secondary">
                        Maintain customer contact and billing information.
                    </p>
                    <span class="badge bg-secondary">Coming soon</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3 text-warning">
                        <i class="bi bi-receipt fs-1"></i>
                    </div>
                    <h5 class="card-title">Invoices</h5>
                    <p class="text-secondary">
                        Create invoices and calculate taxes and totals.
                    </p>
                    <span class="badge bg-secondary">Coming soon</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3 text-info">
                        <i class="bi bi-bar-chart fs-1"></i>
                    </div>
                    <h5 class="card-title">Reports</h5>
                    <p class="text-secondary">
                        Review sales, payments and outstanding balances.
                    </p>
                    <span class="badge bg-secondary">Coming soon</span>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5 p-4 rounded-3 border bg-light">
        <h5>Getting Started</h5>
        <p class="mb-3">
            Start by adding your products. Customer management and invoice
            generation will be added in the next development stages.
        </p>
        <a asp-controller="Products"
           asp-action="Create"
           class="btn btn-outline-primary">
            Create Your First Product
        </a>
    </div>

</div>
