
@model InvoicePro.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
    var subtotal = Model.InvoiceLines.Sum(x => x.LineSubtotal);
    var taxTotal = Model.InvoiceLines.Sum(x => x.TaxAmount);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none">
                &larr; Back to Invoices
            </a>
            <h2 class="fw-bold mt-3 mb-1">
                Invoice @Model.InvoiceNumber
            </h2>
            <span class="badge bg-secondary">@Model.Status</span>
        </div>

        <button type="button"
                class="btn btn-outline-primary"
                onclick="window.print()">
            Print Invoice
        </button>
    </div>

    <div class="card border-0 shadow-sm" id="invoicePrintArea">
        <div class="card-body p-4 p-md-5">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h4 class="fw-bold">INVOICE</h4>
                    <p class="text-muted mb-1">
                        Invoice No: @Model.InvoiceNumber
                    </p>
                    <p class="text-muted mb-1">
                        Date: @Model.InvoiceDate.ToString("dd MMM yyyy")
                    </p>
                    <p class="text-muted">
                        Due: @Model.DueDate.ToString("dd MMM yyyy")
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <h5 class="fw-semibold">Bill To</h5>
                    <p class="mb-1">
                        <strong>@Model.Customer.Name</strong>
                    </p>
                    <p class="text-muted mb-0">
                        @Model.Customer.Email
                    </p>
                </div>
            </div>

            <hr />

            <h5 class="fw-semibold mb-3">Invoice Items</h5>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Tax %</th>
                            <th class="text-end">Tax Amount</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.InvoiceLines)
                        {
                            <tr>
                                <td>@line.Product.Name</td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end">
                                    @line.UnitPrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                                </td>
                                <td class="text-end">
                                    @line.TaxPercentage.ToString("0.##")%
                                </td>
                                <td class="text-end">
                                    @line.TaxAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                                </td>
                                <td class="text-end fw-semibold">
                                    @line.LineTotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end mt-4">
                <div class="col-md-5 col-lg-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>
                            @subtotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax Total</span>
                        <span>
                            @taxTotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fs-5 fw-bold">
                        <span>Grand Total</span>
                        <span>
                            @Model.TotalAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        #invoicePrintArea,
        #invoicePrintArea * {
            visibility: visible;
        }

        #invoicePrintArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none !important;
        }
    }
</style>
