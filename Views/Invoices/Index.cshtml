@model IEnumerable<InvoicePro.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Invoices</h2>
            <p class="text-muted mb-0">
                Create and manage your customer invoices.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Invoices"
               asp-action="ExportCsv"
               class="btn btn-outline-success">
                Export CSV
            </a>

            <a asp-controller="Invoices"
               asp-action="Create"
               class="btn btn-primary">
                + Create Invoice
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="mb-3">
                <label for="invoiceSearch" class="form-label fw-semibold">
                    Search Invoices
                </label>

                <input type="search"
                       id="invoiceSearch"
                       class="form-control"
                       placeholder="Search by invoice number or customer name..."
                       autocomplete="off" />

                <small class="text-muted">
                    Results update automatically as you type.
                </small>
            </div>

            <div id="searchError"
                 class="alert alert-danger d-none"
                 role="alert"></div>

            <div id="invoiceResults"
                 aria-live="polite"
                 aria-busy="false">
                <partial name="_InvoiceSearchResults" model="Model" />
            </div>

            <div id="searchLoading"
                 class="text-muted small mt-2 d-none">
                Searching invoices...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("invoiceSearch");
            const results = document.getElementById("invoiceResults");
            const searchError = document.getElementById("searchError");
            const loading = document.getElementById("searchLoading");

            let debounceTimer;
            let activeController;

            searchInput.addEventListener("input", () => {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(async () => {
                    if (activeController) {
                        activeController.abort();
                    }

                    const controller = new AbortController();
                    activeController = controller;

                    results.setAttribute("aria-busy", "true");
                    loading.classList.remove("d-none");
                    searchError.classList.add("d-none");

                    try {
                        const url =
                            '@Url.Action("Search", "Invoices")'
                            + '?term='
                            + encodeURIComponent(searchInput.value);

                        const response = await fetch(url, {
                            method: "GET",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            signal: controller.signal
                        });

                        if (!response.ok) {
                            throw new Error("Invoice search failed.");
                        }

                        const html = await response.text();

                        // Ignore results from an outdated request.
                        if (activeController !== controller) {
                            return;
                        }

                        results.innerHTML = html;
                    } catch (exception) {
                        if (exception.name !== "AbortError") {
                            searchError.textContent =
                                "Unable to search invoices. Please try again.";
                            searchError.classList.remove("d-none");
                        }
                    } finally {
                        if (activeController === controller) {
                            results.setAttribute("aria-busy", "false");
                            loading.classList.add("d-none");
                            activeController = null;
                        }
                    }
                }, 300);
            });
        })();
    </script>
}
