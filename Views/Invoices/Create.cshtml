
@model InvoicePro.Models.Invoice

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            &larr; Back to Invoices
        </a>

        <h2 class="fw-bold mt-3">Create Invoice</h2>
        <p class="text-muted">
            Enter the basic details for your invoice.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="InvoiceNumber"
                               class="form-label"></label>
                        <input asp-for="InvoiceNumber"
                               class="form-control"
                               placeholder="e.g. INV-2026-001" />
                        <span asp-validation-for="InvoiceNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId"
                               class="form-label"></label>
                        <select asp-for="CustomerId"
                                asp-items="ViewBag.CustomerId"
                                class="form-select">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="InvoiceDate"
                               class="form-label"></label>
                        <input asp-for="InvoiceDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="InvoiceDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DueDate"
                               class="form-label"></label>
                        <input asp-for="DueDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DueDate"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Invoice
                    </button>

                    <a asp-controller="Invoices"
   asp-action="ExportCsv"
   class="btn btn-outline-success">
    Export CSV
</a>
                </div>

            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        
const products = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
        ((IEnumerable<InvoicePro.Models.Product>)(ViewBag.Products
            ?? Enumerable.Empty<InvoicePro.Models.Product>()))
            .Select(p => new {
                p.ProductId,
                p.Name,
                p.UnitPrice
            })
    )
);


const taxRates = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
        ((IEnumerable<InvoicePro.Models.TaxRate>)(ViewBag.TaxRates
            ?? Enumerable.Empty<InvoicePro.Models.TaxRate>()))
            .Select(t => new {
                t.TaxRateId,
                t.TaxName
            })
    )
);


        const body = document.getElementById("invoiceItemsBody");
        let rowIndex = 0;

        function money(value) {
            return new Intl.NumberFormat("en-IN", {
                style: "currency",
                currency: "INR"
            }).format(value);
        }

        function addRow() {
            const i = rowIndex++;
            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    <select name="InvoiceLines[${i}].ProductId"
                            class="form-select product-select" required>
                        <option value="">Select product</option>
                        ${products.map(p =>
                            `<option value="${p.productId}">
                                ${p.name}
                            </option>`
                        ).join("")}
                    </select>
                </td>
                <td>
                    <input name="InvoiceLines[${i}].Quantity"
                           type="number" min="1" max="100000"
                           value="1" class="form-control quantity-input"
                           required />
                </td>
                <td>
                    <input name="InvoiceLines[${i}].UnitPrice"
                           type="number" step="0.01" min="0.01"
                           class="form-control price-input"
                           readonly required />
                </td>
                <td>
                    <select name="InvoiceLines[${i}].TaxRateId"
                            class="form-select tax-select" required>
                        <option value="">Select tax</option>
                        ${taxRates.map(t =>
                            `<option value="${t.taxRateId}">
                                ${t.name} (${t.percentage}%)
                            </option>`
                        ).join("")}
                    </select>
                </td>
                <td class="line-subtotal">₹0.00</td>
                <td>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm remove-row">
                        Remove
                    </button>
                </td>
            `;

            body.appendChild(row);
            row.querySelector(".product-select")
                .addEventListener("change", () => {
                    const selected = products.find(
                        p => p.productId == row.querySelector(".product-select").value
                    );

                    row.querySelector(".price-input").value =
                        selected ? selected.unitPrice : "";

                    calculateTotals();
                });

            row.querySelector(".tax-select")
                .addEventListener("change", calculateTotals);

            row.querySelector(".quantity-input")
                .addEventListener("input", calculateTotals);

            row.querySelector(".remove-row")
                .addEventListener("click", () => {
                    row.remove();
                    calculateTotals();
                });

            calculateTotals();
        }

        function calculateTotals() {
            let subtotal = 0;
            let taxTotal = 0;

            body.querySelectorAll("tr").forEach(row => {
                const productId = row.querySelector(".product-select").value;
                const taxId = row.querySelector(".tax-select").value;
                const quantity = Number(
                    row.querySelector(".quantity-input").value
                ) || 0;

                const product = products.find(p => p.productId == productId);
                const tax = taxRates.find(t => t.taxRateId == taxId);

                const price = product ? Number(product.unitPrice) : 0;
                const lineSubtotal = price * quantity;
                const lineTax = lineSubtotal *
                    (tax ? Number(tax.percentage) : 0) / 100;

                subtotal += lineSubtotal;
                taxTotal += lineTax;

                row.querySelector(".line-subtotal").textContent =
                    money(lineSubtotal);
            });

            document.getElementById("subtotalDisplay").textContent =
                money(subtotal);

            document.getElementById("taxDisplay").textContent =
                money(taxTotal);

            document.getElementById("grandTotalDisplay").textContent =
                money(subtotal + taxTotal);
        }

        document.getElementById("addInvoiceItem")
            .addEventListener("click", addRow);

        addRow();
    </script>
}

