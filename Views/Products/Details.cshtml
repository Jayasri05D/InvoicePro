
@model InvoicePro.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<dl class="row">
    <dt class="col-sm-3">Product ID</dt>
    <dd class="col-sm-9">@Model.ProductId</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Unit Price</dt>
    <dd class="col-sm-9">@Model.UnitPrice.ToString("C")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Inactive")
    </dd>
</dl>

<a asp-action="Edit"
   asp-route-id="@Model.ProductId"
   class="btn btn-primary">Edit</a>

<a asp-action="Index"
   class="btn btn-secondary">Back to Products</a>
